generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MediaType {
  MOVIE
  TV
}

enum Status {
  WANT
  WATCHED
}

model Title {
  id               String    @id @default(cuid())
  tmdbId           Int
  mediaType        MediaType
  imdbId           String?
  title            String
  year             Int?
  posterUrl        String?
  backdropUrl      String?
  overview         String?
  tagline          String?
  runtime          Int?
  numberOfSeasons  Int?
  numberOfEpisodes Int?
  genres           String[]
  spokenLanguages  String[]
  // Canonical mood labels from src/lib/moods.ts, stored exactly like genres.
  moods            String[]
  // Set whenever the tagger has judged this title, INCLUDING when it matched no
  // mood at all. `moods = []` alone can't tell "asked, legitimately nothing"
  // from "never asked", and the backfill selector, the tag-once gate, and the
  // untagged count on the mood screen all turn on that distinction.
  moodsTaggedAt    DateTime?
  cast             Json      @default("[]")
  director         String?
  watchProviders   Json      @default("[]")
  watchLink        String?
  tmdbScore        Float?
  imdbScore        String?
  rtScore          String?
  metacriticScore  String?
  fetchedAt        DateTime  @default(now())

  // Personal data (status, note, rating, pin, dates) lives on ListEntry, per
  // user. Title is the shared catalog only.
  entries  ListEntry[]
  messages Message[]

  @@unique([tmdbId, mediaType])
}

model User {
  id        String   @id @default(cuid())
  // Stored lowercase; the allowlist comparison is case-insensitive.
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  entries ListEntry[]

  // Two relations to Conversation (one per side of the pair), hence the names.
  conversationsAsA Conversation[] @relation("ConversationUserA")
  conversationsAsB Conversation[] @relation("ConversationUserB")
  messages         Message[]
  reactions        Reaction[]
}

// A one-on-one chat. The pair is stored sorted (userAId < userBId, string
// compare) so a pair maps to exactly one row and @@unique can enforce it
// without caring who started the chat.
model Conversation {
  id              String    @id @default(cuid())
  userAId         String
  userBId         String
  userALastReadAt DateTime?
  userBLastReadAt DateTime?
  createdAt       DateTime  @default(now())
  lastMessageAt   DateTime  @default(now())

  userA    User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

// A message is either text or a shared title card. senderRating snapshots the
// sender's rating at send time so a later re-rating doesn't rewrite history.
model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  createdAt      DateTime @default(now())
  text           String?
  titleId        String?
  senderRating   Int?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  // Restrict: a shared Title is catalogue data and must never be deleted out
  // from under a message that references it.
  title        Title?       @relation(fields: [titleId], references: [id], onDelete: Restrict)
  reactions    Reaction[]

  @@index([conversationId, createdAt])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

// One user's relationship to a shared Title: their status, note, rating and pin.
// Title stays the shared catalogue; everything personal lives here.
model ListEntry {
  id        String    @id @default(cuid())
  userId    String
  titleId   String
  status    Status    @default(WANT)
  note      String?
  myRating  Int?
  pinned    Boolean   @default(false)
  pinnedAt  DateTime?
  addedAt   DateTime  @default(now())
  watchedAt DateTime?

  // Deleting a user removes their list, but a Title is shared by everyone, so
  // it can never be deleted out from under entries that reference it.
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Restrict)

  @@unique([userId, titleId])
  @@index([userId, status])
}

// RETAINED INTENTIONALLY, no longer read by any code. The For You feature that
// owned these two tables was removed; dropping them is a separate later cleanup
// so a feature change never carries a destructive migration.
model RecommendationSet {
  id          String   @id @default(cuid())
  suggestions Json     @default("[]")
  model       String
  sourceCount Int      @default(0)
  generatedAt DateTime @default(now())

  @@index([generatedAt])
}

// Retained intentionally alongside RecommendationSet; see the note above.
model DismissedTitle {
  id          String    @id @default(cuid())
  tmdbId      Int
  mediaType   MediaType
  dismissedAt DateTime  @default(now())

  @@unique([tmdbId, mediaType])
}
