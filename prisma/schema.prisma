generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MediaType {
  MOVIE
  TV
}

enum Status {
  WANT
  WATCHED
}

model Title {
  id               String    @id @default(cuid())
  tmdbId           Int
  mediaType        MediaType
  imdbId           String?
  title            String
  year             Int?
  posterUrl        String?
  backdropUrl      String?
  overview         String?
  tagline          String?
  runtime          Int?
  numberOfSeasons  Int?
  numberOfEpisodes Int?
  genres           String[]
  spokenLanguages  String[]
  // Canonical mood labels from src/lib/moods.ts, stored exactly like genres.
  moods            String[]
  // Set whenever the tagger has judged this title, INCLUDING when it matched no
  // mood at all. `moods = []` alone can't tell "asked, legitimately nothing"
  // from "never asked", and the backfill selector, the tag-once gate, and the
  // untagged count on the mood screen all turn on that distinction.
  moodsTaggedAt    DateTime?
  cast             Json      @default("[]")
  director         String?
  watchProviders   Json      @default("[]")
  watchLink        String?
  tmdbScore        Float?
  imdbScore        String?
  rtScore          String?
  metacriticScore  String?
  fetchedAt        DateTime  @default(now())

  // Personal data (status, note, rating, pin, dates) lives on ListEntry, per
  // user. Title is the shared catalog only.
  entries ListEntry[]

  @@unique([tmdbId, mediaType])
}

model User {
  id        String   @id @default(cuid())
  // Stored lowercase; the allowlist comparison is case-insensitive.
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  entries ListEntry[]
}

// One user's relationship to a shared Title: their status, note, rating and pin.
// Title stays the shared catalogue; everything personal lives here.
model ListEntry {
  id        String    @id @default(cuid())
  userId    String
  titleId   String
  status    Status    @default(WANT)
  note      String?
  myRating  Int?
  pinned    Boolean   @default(false)
  pinnedAt  DateTime?
  addedAt   DateTime  @default(now())
  watchedAt DateTime?

  // Deleting a user removes their list, but a Title is shared by everyone, so
  // it can never be deleted out from under entries that reference it.
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Restrict)

  @@unique([userId, titleId])
  @@index([userId, status])
}

// RETAINED INTENTIONALLY, no longer read by any code. The For You feature that
// owned these two tables was removed; dropping them is a separate later cleanup
// so a feature change never carries a destructive migration.
model RecommendationSet {
  id          String   @id @default(cuid())
  suggestions Json     @default("[]")
  model       String
  sourceCount Int      @default(0)
  generatedAt DateTime @default(now())

  @@index([generatedAt])
}

// Retained intentionally alongside RecommendationSet; see the note above.
model DismissedTitle {
  id          String    @id @default(cuid())
  tmdbId      Int
  mediaType   MediaType
  dismissedAt DateTime  @default(now())

  @@unique([tmdbId, mediaType])
}
